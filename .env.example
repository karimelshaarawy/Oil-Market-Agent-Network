# Copy this file to .env and fill in the provider credentials.
# Never commit .env or any file containing real API keys.

# LLM provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_BASE_URL=
MODEL_NAME=gpt-4o-mini

# LLM budgets
ECON_MAX_COMPLETION_TOKENS=8192
ECON_CAMEL_TOKEN_LIMIT=32768

# Reasoning models
ECON_ENABLE_THINKING=false
ECON_REASONING_EFFORT=medium

# Timeouts (seconds)
ECON_INTERVIEW_TIMEOUT_SECONDS=60
ECON_REPORT_TIMEOUT_SECONDS=60
ECON_SCENARIO_TIMEOUT_SECONDS=60

# Live news (optional)
ECON_NEWS_LOOKBACK_DAYS=7
ECON_NEWS_FEEDS=
